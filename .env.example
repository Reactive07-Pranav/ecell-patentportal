# ==============================================================================
# Manipal University Jaipur — Patent Application & Disclosure Portal
# Centralized Environment Variables Template
# Copy this file to .env or .env.local to customize your deployment.
# ==============================================================================

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://mock-instance.supabase.co
VITE_SUPABASE_ANON_KEY=mock-key

# Institutional URLs & Domain Configuration
VITE_PORTAL_BASE_URL=https://patents.muj.manipal.edu
VITE_INSTITUTION_NAME="Manipal University Jaipur"
VITE_INSTITUTION_SHORT_NAME=MUJ
VITE_INSTITUTION_WEBSITE_URL=https://jaipur.manipal.edu
VITE_IPR_CELL_URL=https://jaipur.manipal.edu/research/ipr-cell
VITE_ALLOWED_EMAIL_DOMAIN=muj.manipal.edu

# Communication & Contact Details
VITE_CONTACT_EMAIL=ipr.cell@muj.manipal.edu
VITE_COORDINATOR_NAME="Dr. Dorelal Sharma"
VITE_COORDINATOR_EMAIL=dorelal.coordinator@muj.manipal.edu

# Supabase Storage Bucket Names
VITE_STORAGE_BUCKET_DOCS=patent-documents
VITE_STORAGE_BUCKET_DRAWINGS=patent-drawings

# Application Runtime Flags
VITE_APP_ENV=development
VITE_ENABLE_MOCK_FALLBACK=true
